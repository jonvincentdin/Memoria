            "request": "launch",
            "cwd": "${workspaceFolder}/backend",
            "mainClass": "com.csit321g1.lukydizy.memoria.MemoriaApplication",
            "projectName": "memoria",
            "args": "",
            "env": {
                "SPRING_PROFILES_ACTIVE": "default",
                "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/memoria",
                "SPRING_DATASOURCE_USERNAME": "memoria",
                "SPRING_DATASOURCE_PASSWORD": "memoria",
                "SESSION_COOKIE_SECURE": "false"
            }
        },
        {
            "type": "java",
            "name": "Spring Boot - MemoriaApplication (Supabase)",
            "request": "launch",
            "cwd": "${workspaceFolder}/backend",
            "mainClass": "com.csit321g1.lukydizy.memoria.MemoriaApplication",
