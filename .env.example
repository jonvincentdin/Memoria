# Copy this file to .env.local (never commit .env.local).
# Set these variables in your terminal before running the backend.
#
# --- Supabase (hosted) ---
# Obtain from: Supabase dashboard → Project Settings → Database → Connection string (JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<db>
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-password
SPRING_PROFILES_ACTIVE=supabase

# --- Local PostgreSQL (optional override) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/memoria
# SPRING_DATASOURCE_USERNAME=memoria
# SPRING_DATASOURCE_PASSWORD=your-local-password
# SPRING_PROFILES_ACTIVE=   (leave blank or omit to use the default profile)

# --- Port override (optional) ---
# SERVER_PORT=8080
